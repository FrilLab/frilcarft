{
  "name": "frilcraft-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @frillab/playground",
    "build": "npm run build:library && npm run build:playground && npm run build:consumer && npm run build:source-consumer",
    "build:library": "npm run build --workspace @frillab/interactive",
    "build:playground": "npm run build --workspace @frillab/playground",
    "build:consumer": "vite build --config tests/consumers/react-vite/vite.config.ts && node tests/consumers/react-vite/verify-build.mjs",
    "build:source-consumer": "node tests/consumers/source-vite/build.mjs",
    "registry:sync": "node scripts/sync-friladd-registry.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "npm run preview --workspace @frillab/playground",
    "test:registry": "node scripts/verify-friladd-registry.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "typescript-api": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
