{
  "name": "frilcraft-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @frillab/playground",
    "build": "npm run build:library && npm run build:playground && npm run build:consumer && npm run build:source-consumer",
    "build:library": "npm run build --workspace @frillab/interactive",
    "build:playground": "npm run build --workspace @frillab/playground",
    "build:consumer": "vite build --config tests/consumers/react-vite/vite.config.ts && node tests/consumers/react-vite/verify-build.mjs",
    "build:source-consumer": "node tests/consumers/source-vite/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "npm run preview --workspace @frillab/playground"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
